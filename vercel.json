{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --ignore-scripts",
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "static",
  "rewrites": [
    {
      "source": "/w(\\d+)/api/(.*)",
      "destination": "https://openfrontio-deploy-production.up.railway.app/w$1/api/$2"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://openfrontio-deploy-production.up.railway.app/api/$1"
    },
    {
      "source": "/maps/(.*)",
      "destination": "https://openfrontio-deploy-production.up.railway.app/maps/$1"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
